            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Hay una línea con cantidad 4', () => { pm.expect(body.items).to.have.lengthOf(1); pm.expect(body.items[0].quantity).to.eql(4); });",
              "pm.test('Cada línea trae los campos esperados', () => pm.expect(body.items[0]).to.include.all.keys('itemId', 'productId', 'productName', 'unitPrice', 'quantity', 'subtotal'));",
              "pm.test('totalItems es 4', () => pm.expect(body.totalItems).to.eql(4));",
              "const sum = body.items.reduce((a, i) => a + Number(i.subtotal), 0);",
              "pm.test('total es la suma de los subtotales', () => pm.expect(Number(body.total)).to.be.closeTo(sum, 0.001));"
            ]
          }
        }
