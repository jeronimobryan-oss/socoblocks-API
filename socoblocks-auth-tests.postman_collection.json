{
  "info": {
    "name": "Socoblocks - Pruebas de Autenticación JWT y Carrito",
    "description": "Colección para verificar el flujo completo de autenticación (registro, login, acceso a endpoints protegidos y validación de JWT) y del carrito de compras (RF-008 a RF-011: agregar, consultar, actualizar y eliminar productos) de socoblocks-API. Requiere los productos semilla de ProductInitializer: productId=1 (stock 5) y outOfStockProductId=2 (stock 0). Ejecutar en orden con el Collection Runner.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "username", "value": "" },
    { "key": "password", "value": "Password123!" },
    { "key": "accessToken", "value": "" },
    { "key": "tamperedToken", "value": "" },
    { "key": "adminUsername", "value": "admin" },
    { "key": "adminPassword", "value": "change-me" },
    { "key": "adminAccessToken", "value": "" },
    { "key": "productId", "value": "1" },
    { "key": "outOfStockProductId", "value": "2" },
    { "key": "cartItemId", "value": "" },
    { "key": "username2", "value": "" },
    { "key": "accessToken2", "value": "" }
  ],
  "item": [
    {
      "name": "1. Registro - usuario nuevo (201)",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('username', 'testuser_' + Date.now());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('Devuelve username correcto', () => pm.expect(body.username).to.eql(pm.collectionVariables.get('username')));",
              "pm.test('Rol asignado es USER', () => pm.expect(body.role).to.eql('USER'));",
              "pm.test('No se expone el password en la respuesta', () => pm.expect(body.password).to.be.undefined);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/auth/register", "host": ["{{baseUrl}}"], "path": ["api", "auth", "register"] }
      }
    },
