    {
      "name": "4. Login - credenciales válidas (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('Devuelve accessToken no vacío', () => pm.expect(body.accessToken).to.be.a('string').and.not.empty);",
              "pm.test('tokenType es Bearer', () => pm.expect(body.tokenType).to.eql('Bearer'));",
              "pm.test('expiresIn es numérico y positivo', () => pm.expect(body.expiresIn).to.be.a('number').and.above(0));",
              "pm.test('El token tiene 3 segmentos (header.payload.signature)', () => pm.expect(body.accessToken.split('.').length).to.eql(3));",
              "pm.collectionVariables.set('accessToken', body.accessToken);"
            ]
          }
        }
      ],
