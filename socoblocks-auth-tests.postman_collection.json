    {
      "name": "17. POST /carrito/items - agregar producto (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status 201 Created', () => pm.response.to.have.status(201));",
              "const body = pm.response.json();",
              "pm.test('El carrito tiene una línea', () => pm.expect(body.items).to.have.lengthOf(1));",
              "const line = body.items[0];",
              "pm.test('La línea corresponde al producto agregado', () => pm.expect(String(line.productId)).to.eql(String(pm.collectionVariables.get('productId'))));",
              "pm.test('Cantidad es 2', () => pm.expect(line.quantity).to.eql(2));",
              "pm.test('subtotal = unitPrice * quantity', () => pm.expect(Number(line.subtotal)).to.be.closeTo(Number(line.unitPrice) * 2, 0.001));",
              "pm.test('totalItems es 2', () => pm.expect(body.totalItems).to.eql(2));",
              "pm.test('total coincide con el subtotal', () => pm.expect(Number(body.total)).to.be.closeTo(Number(line.subtotal), 0.001));",
              "pm.collectionVariables.set('cartItemId', line.itemId);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
